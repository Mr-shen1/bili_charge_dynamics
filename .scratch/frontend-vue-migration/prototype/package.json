{
  "name": "vue-image-preview-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "images": "node server/imageServer.mjs",
    "dev:lan": "vite --host 0.0.0.0 --port 4318 --strictPort",
    "serve:lan": "vite preview --host 0.0.0.0 --port 4318 --strictPort"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.13"
  }
}
