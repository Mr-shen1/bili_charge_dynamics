{
  "name": "bili-charge-dynamics-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:fault": "vite --mode fault",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:manage": "playwright test --config playwright.manage.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:e2e-projects",
    "check:dist": "pnpm build && pnpm build:mock && pnpm check:isolation && pnpm check:data-parity",
    "check:e2e-projects": "node scripts/check-e2e-projects.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:data-parity": "node scripts/check-data-parity.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:mock": "vue-tsc --noEmit && vite build --mode mock --outDir dist-mock",
    "build:fault": "vue-tsc --noEmit && vite build --mode fault --outDir dist-mock",
    "preview": "vite preview",
    "preview:mock": "vite preview --outDir dist-mock",
    "images": "node server/imageServer.mjs",
    "serve:lan": "vite preview --outDir dist-mock --host 0.0.0.0 --port 4318 --strictPort"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.10.13",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.13"
  }
}
