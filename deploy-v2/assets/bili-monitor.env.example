# /etc/bili-monitor/env —— systemd 环境文件模板
#
# 安装：
#     sudo install -D -m 0600 -o root -g root \
#         deploy-v2/assets/bili-monitor.env.example /etc/bili-monitor/env
#     sudo editor /etc/bili-monitor/env
#
# 权限必须是 0600 且属主为 root（systemd 以 root 读取后注入给 bili 用户）。
# 本文件不进版本库、不进构建产物、不出现在日志或命令行参数中。
# 应用本身不加载 .env；只有 systemd 读取本文件。

# ---- 必填：持久化数据库 ----
# 必须是仓库外、持久卷上的绝对路径；目录需 bili 用户可写。
# 不要用默认的 backend/data/monitor.sqlite（仅适合本地开发），
# 也不要放在发布目录里，否则升级会覆盖。
BILI_DATABASE_PATH=/srv/bili-monitor/monitor.sqlite

# ---- 可选：阿里云 OSS 媒体归档 ----
# 七项同时存在才启用；全部不设置则媒体保持「待归档」，不占本地磁盘。
#
# ⚠️ 不用时**必须保持下面七行全部注释掉**，不要写成 `BILI_OSS_ENDPOINT=` 这种
# 空值形式。systemd EnvironmentFile 会把 `VAR=` 设为空字符串，而空字符串既不是
# “未设置”（不会停用）又是 falsy（触发“配置不完整”），启动时会抛
# ValueError: Incomplete OSS configuration 直接退出。见 backend/bili_monitor/oss.py:39-45。
#
# 启用时取消注释并逐项填写：
#   ENDPOINT 必须无路径、无端口、以 .aliyuncs.com 结尾
#   PUBLIC_BASE_URL 为浏览器直取的公开前缀，可被直接访问与外链——加登录也不保护图片
#   SECURITY_TOKEN 仅 STS 临时凭据场景需要，长期 AK 时省略
#   ACCESS_KEY_* 建议用专用 RAM 子账号，权限只授该桶 oss:PutObject
#
# 填好后先预检再重启，脚本不打印密钥、不发网络请求：
#   sudo install -m 0755 -o root -g root scripts/check-oss-env.sh \
#       /usr/local/sbin/bili-monitor-check-oss
#   sudo /usr/local/sbin/bili-monitor-check-oss
# BILI_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# BILI_OSS_REGION=cn-shenzhen
# BILI_OSS_BUCKET=your-bucket-name
# BILI_OSS_ACCESS_KEY_ID=
# BILI_OSS_ACCESS_KEY_SECRET=
# BILI_OSS_PUBLIC_BASE_URL=https://your-bucket-name.oss-cn-shenzhen.aliyuncs.com
# BILI_OSS_SECURITY_TOKEN=

# ---- 可选：B 站登录 Cookie（仅服务端） ----
# 同样必须保持注释，不要留空值：backend/bili_monitor/source_cookies.py:91-103
# 只在变量完全不存在时返回空元组，空字符串会去读取空路径并拒绝启动。
#
# 启用时指向仓库外、属主为 bili、权限 0600 的文件，其直属目录 0700。
# 启动时读取一次；格式无效会拒绝启动。默认匿名。
# 路径与云端一致（固定文件名 cookie.txt）：
# BILI_COOKIE_FILE=/srv/bili-monitor/credentials/cookie.txt

# ---- 可选：飞书通知路由（第三个进程） ----
# 指向仓库外、属主为 bili（或 root 可读）、权限≤0640 的 JSON 配置文件；文件内含
# webhook 与可选签名密钥，不得进版本库/产物/日志。格式见 docs/backend/api/notification-process.md#2-配置。
# 未设置时统一入口只托管 API＋collector，不会投递任何飞书消息。
# 路由修复：修改本文件后重启服务（运行中不热加载）；已排队记录与成功目标状态保留。
# 路径与云端一致（固定文件名 notifications.json，目录 0700）：
# BILI_NOTIFICATION_CONFIG=/srv/bili-monitor/credentials/notifications.json

# ---- 运行时 ----
# 配合 ProtectSystem=strict：只读文件系统下禁止写 .pyc。
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
