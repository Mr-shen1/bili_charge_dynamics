{
  "name": "bili-charge-dynamics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": "24.21.0" },
  "scripts": {
    "dev": "vite",
    "dev:fault": "vite --mode fault",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:manage": "playwright test --config playwright.manage.config.ts",
    "test:e2e:archive": "playwright test --config playwright.archive.config.ts",
    "test:e2e:preview": "pnpm build:mock && E2E_TARGET=preview playwright test",
    "test:delivery": "node scripts/verify-static-delivery.mjs",
    "test:http": "node scripts/verify-http-navigation.mjs",
    "build": "tsc --noEmit && vite build",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
