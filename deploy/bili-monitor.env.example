# /etc/bili-monitor/env —— systemd 环境文件模板
#
# 安装：
#     sudo install -D -m 0600 -o root -g root \
#         deploy/bili-monitor.env.example /etc/bili-monitor/env
#     sudo editor /etc/bili-monitor/env
#
# 权限必须是 0600 且属主为 root（systemd 以 root 读取后注入给 bili 用户）。
# 本文件不进版本库、不进构建产物、不出现在日志或命令行参数中。
# 应用本身不加载 .env；只有 systemd 读取本文件。

# ---- 必填：持久化数据库 ----
# 必须是仓库外、持久卷上的绝对路径；目录需 bili 用户可写。
# 不要用默认的 backend/data/monitor.sqlite（仅适合本地开发），
# 也不要放在发布目录里，否则升级会覆盖。
BILI_DATABASE_PATH=/srv/bili-monitor/monitor.sqlite

# ---- 可选：阿里云 OSS 媒体归档 ----
# 七项同时存在才启用；任一为空字符串会导致启动失败（见 oss.py:36-45）。
# 全部留空则媒体保持「待归档」，不占本地磁盘。
# ENDPOINT 必须无路径、无端口、以 .aliyuncs.com 结尾，例如：
#   https://oss-cn-shenzhen.aliyuncs.com
# PUBLIC_BASE_URL 为浏览器直取的公开前缀，例如：
#   https://<bucket>.oss-cn-shenzhen.aliyuncs.com
# 注意：公开 OSS URL 可被直接访问与外链，加登录也不会保护图片。
BILI_OSS_ENDPOINT=
BILI_OSS_REGION=
BILI_OSS_BUCKET=
BILI_OSS_ACCESS_KEY_ID=
BILI_OSS_ACCESS_KEY_SECRET=
BILI_OSS_PUBLIC_BASE_URL=
# 仅在 STS 临时凭据场景填写；使用长期 AK 时留空。
BILI_OSS_SECURITY_TOKEN=

# ---- 可选：B 站登录 Cookie（仅服务端） ----
# 指向仓库外、属主为 bili、权限 0600 的文件，其直属目录 0700。
# 启动时读取一次；格式无效会拒绝启动。默认匿名，留空即可。
BILI_COOKIE_FILE=

# ---- 运行时 ----
# 配合 ProtectSystem=strict：只读文件系统下禁止写 .pyc。
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
